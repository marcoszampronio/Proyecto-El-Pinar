# =====================================================
# CONFIGURACIÓN DEL BACKEND — Complejo El Pinar
# Copiá este archivo como .env y completá los valores
# NUNCA subas el .env a GitHub (ya está en .gitignore)
# =====================================================

# Datos de tu proyecto Supabase (Project Settings > API)
SUPABASE_URL=https://tuproyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# Emails autorizados a usar el panel de admin (separados por coma)
ADMIN_EMAILS=mateo@gmail.com,tumail@gmail.com

# Email desde donde salen los correos automáticos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=turnoselpinar@gmail.com
SMTP_PASS=acá-va-la-contraseña-de-aplicación-de-gmail
# OJO: no es la contraseña normal de Gmail. Ver README paso "Configurar Gmail"

# Número de WhatsApp del complejo (con código de país, sin +, sin espacios)
# Ejemplo Argentina: 549 + código de área + número (sin el 15)
# Ej: para 343 555-1234 → 5493435551234
WHATSAPP_NUMERO=549XXXXXXXXXX

# Alias o CBU para transferencias (se muestra al cliente al reservar)
ALIAS_TRANSFERENCIA=elpinar.canchas.mp

# Dominios que pueden llamar a la API (separados por coma). En produccion poner
# la URL de Netlify. Si se deja vacio, se acepta cualquier origen (solo para dev).
CORS_ORIGINS=

# Minutos que un turno queda "reservado" esperando el comprobante antes de
# liberarse solo. Por defecto 180 (3 horas).
PENDING_EXPIRE_MIN=180

PORT=3001
