# =====================================================
# CONFIGURACIÓN DEL BACKEND — Complejo El Pinar
# Copiá este archivo como .env y completá los valores
# NUNCA subas el .env a GitHub (ya está en .gitignore)
# =====================================================

# Datos de tu proyecto Supabase (Project Settings > API)
SUPABASE_URL=https://tuproyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# Emails autorizados a usar el panel de admin (separados por coma)
ADMIN_EMAILS=mateo@gmail.com,tumail@gmail.com

# ---- EMAIL ----
# Direccion y nombre del remitente (lo que ve el cliente).
EMAIL_FROM=turnoselpinar@gmail.com
EMAIL_FROM_NAME=Complejo El Pinar
#
# Opcion A (recomendada en Render, que bloquea SMTP): API de Brevo.
#   Crear cuenta en brevo.com > Senders & IPs: verificar EMAIL_FROM
#   > SMTP & API > crear una API key (v3) y pegarla aca.
BREVO_API_KEY=
#
# Opcion B: SMTP (Gmail u otro). Solo si el host permite el puerto 587.
#   SMTP_PASS = contrasena de APLICACION de Gmail, no la normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Número de WhatsApp del complejo (con código de país, sin +, sin espacios)
# Ejemplo Argentina: 549 + código de área + número (sin el 15)
# Ej: para 343 555-1234 → 5493435551234
WHATSAPP_NUMERO=549XXXXXXXXXX

# Alias o CBU para transferencias (se muestra al cliente al reservar)
ALIAS_TRANSFERENCIA=elpinar.canchas.mp

# Monto de la reserva en pesos (se muestra al cliente y va en el WhatsApp).
# Por defecto 10000.
MONTO_RESERVA=10000

# Dominios que pueden llamar a la API (separados por coma). En produccion poner
# la URL de la web (Cloudflare Pages). Si se deja vacio, se acepta cualquier
# origen (solo para dev).
CORS_ORIGINS=

# URL del panel (para el boton "Abrir en el panel" de los emails a los admins).
# Ej: https://proyecto-el-pinar.pages.dev/panel
PANEL_URL=

# Minutos que un turno queda "reservado" esperando el comprobante antes de
# liberarse solo. Por defecto 180 (3 horas).
PENDING_EXPIRE_MIN=180

# Día de la semana en que se manda el backup por email (0=Dom ... 5=Vie ... 6=Sáb).
# Poner "todos" para que sea diario. Por defecto 5 (viernes), a las 3:00 ART.
BACKUP_DIA_SEMANA=5

# Caracteristica telefonica del complejo (sin 0). Se usa para armar los links
# de WhatsApp cuando el cliente carga su numero sin caracteristica. Def: 343 (Parana).
AREA_TELEFONO=343

PORT=3001
