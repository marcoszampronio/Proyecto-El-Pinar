+import { useEffect, useRef, useState } from 'react';
+import { api } from '../../api';
+import {
+  hoyISO, proximoDiaHabilitado, sumarDias, esDiaHabilitado, lunesDeLaSemana, partesFecha,
+} from '../../lib/fechas';
+import {
+  dibujarHistoria, hayTurnosLibres, turnosDeAgenda, etiquetasDia, subtituloDia, subtituloSemana,
+} from '../../lib/historiaTurnos';
+import Info from './Info';
+
+// Primer lunes que muestra la vista semanal: la semana en curso, y de viernes en adelante la que viene.
+function semanaInicial() {
+  const dow = new Date().getDay();
+  const lunes = lunesDeLaSemana(hoyISO());
+  return dow === 0 || dow >= 5 ? sumarDias(lunes, 7) : lunes;
+}
+
+function nombreArchivo(modo, ref, estilo) {
+  return `turnos-libres-${modo === 'dia' ? ref : `semana-${ref}`}-${estilo}.png`;
+}
+
+// Arma la historia de Instagram con los turnos libres del día o de la semana, lista para descargar o compartir.
+// Navegador: el selector de día del panel (se le pasa de AdminPanel para no duplicarlo).
+export default function HistoriaTurnos({ Navegador }) {
+  const [modo, setModo] = useState(() => {
+    try { return localStorage.getItem('panel-historia-modo') === 'semana' ? 'semana' : 'dia'; } catch { return 'dia'; }
+  });
+  const [estilo, setEstilo] = useState(() => {
+    try { return ['azul', 'dorado'].includes(localStorage.getItem('panel-historia-estilo')) ? localStorage.getItem('panel-historia-estilo') : 'claro'; } catch { return 'claro'; }
+  });
+  const [fecha, setFecha] = useState(() => proximoDiaHabilitado(hoyISO()));
+  const [lunes, setLunes] = useState(semanaInicial);
+  const [dias, setDias] = useState(null); // [{ fecha, turnos }]
+  const [error, setError] = useState(null);
+  const [cargando, setCargando] = useState(false);
+  const [puedeCompartir, setPuedeCompartir] = useState(false);
+  const canvasRef = useRef(null);
+
+  function elegirEstilo(e) {
+    setEstilo(e);
+    try { localStorage.setItem('panel-historia-estilo', e); } catch { /* sin almacenamiento: no pasa nada */ }
+  }
+  function elegirModo(m) {
+    setModo(m);
+    try { localStorage.setItem('panel-historia-modo', m); } catch { /* sin almacenamiento: no pasa nada */ }
+  }
+
+  // trae la agenda de los días que entran en la imagen
+  useEffect(() => {
+    let vigente = true;
+    async function cargar() {
+      setCargando(true);
+      setError(null);
+      try {
+        let fechas;
+        if (modo === 'dia') {
+          fechas = [fecha];
+        } else {
+          const aperturas = await api.adminAperturas(lunes, sumarDias(lunes, 4)).catch(() => ({ aperturas: [] }));
+          const abiertos = new Set((aperturas.aperturas || []).map((a) => a.reservation_date));
+          const hoy = hoyISO();
+          fechas = [0, 1, 2, 3, 4]
+            .map((n) => sumarDias(lunes, n))
+            .filter((f) => f >= hoy && (esDiaHabilitado(f) || abiertos.has(f)));
+        }
+        const agendas = await Promise.all(fechas.map((f) => api.adminAgenda(f)));
+        if (!vigente) return;
+        const ahora = new Date();
+        setDias(fechas.map((f, i) => ({ fecha: f, ...etiquetasDia(f), turnos: turnosDeAgenda(f, agendas[i], ahora) })));
+      } catch (e) {
+        if (!vigente) return;
+        setError(e.message);
+        setDias(null);
+      } finally {
+        if (vigente) setCargando(false);
+      }
+    }
+    cargar();
+    return () => { vigente = false; };
+  }, [modo, fecha, lunes]);
+
+  // dibuja la imagen cada vez que cambian los datos
+  useEffect(() => {
+    if (!dias || !dias.length || !hayTurnosLibres(dias) || !canvasRef.current) return;
+    const subtitulo = modo === 'dia' ? subtituloDia(dias[0].fecha) : subtituloSemana(dias.map((d) => d.fecha));
+    dibujarHistoria(canvasRef.current, { modo, estilo, subtitulo, dias });
+  }, [dias, modo, estilo]);
+
+  // ¿el celular permite compartir un archivo directo a Instagram?
+  useEffect(() => {
+    try {
+      const prueba = new File([new Blob(['x'], { type: 'image/png' })], 'x.png', { type: 'image/png' });
+      setPuedeCompartir(!!(navigator.canShare && navigator.canShare({ files: [prueba] })));
+    } catch { setPuedeCompartir(false); }
+  }, []);
+
+  function blob() {
+    return new Promise((resolve) => canvasRef.current.toBlob(resolve, 'image/png'));
+  }
+  const ref = dias && dias.length ? dias[0].fecha : hoyISO();
+
+  async function descargar() {
+    const b = await blob();
+    const url = URL.createObjectURL(b);
+    const a = document.createElement('a');
+    a.href = url;
+    a.download = nombreArchivo(modo, ref, estilo);
+    document.body.appendChild(a);
+    a.click();
+    a.remove();
+    setTimeout(() => URL.revokeObjectURL(url), 2000);
+  }
+
+  async function compartir() {
+    const b = await blob();
+    const archivo = new File([b], nombreArchivo(modo, ref, estilo), { type: 'image/png' });
+    try {
+      await navigator.share({ files: [archivo] });
+    } catch (e) {
+      if (e.name !== 'AbortError') setError('No se pudo abrir el menú de compartir. Probá con Descargar.');
+    }
+  }
+
+  const hayDias = dias && dias.length > 0;
+  const hayLibres = hayTurnosLibres(dias);
+  const rangoSemana = (() => {
+    const a = partesFecha(sumarDias(lunes, 1));
+    const b = partesFecha(sumarDias(lunes, 3));
+    return a.mes === b.mes ? `${a.diaNum} al ${b.diaNum} de ${b.mes}` : `${a.diaNum} de ${a.mes} al ${b.diaNum} de ${b.mes}`;
+  })();
+
+  return (
+    <div className="stat-card historia">
+      <h3 style={{ marginTop: 0 }}>
+        Historia de Instagram
+        <Info>Arma una imagen solo con los turnos de fútbol que están libres (lo reservado no se muestra), lista para subir a tu historia. Se calcula con lo que hay en la agenda en este momento: si después entra una reserva, volvé a generarla.</Info>
+      </h3>
+
+      <div className="vista-toggle" role="tablist" aria-label="Qué turnos mostrar">
+        <button type="button" role="tab" aria-selected={modo === 'dia'} className={modo === 'dia' ? 'on' : ''} onClick={() => elegirModo('dia')}>Del día</button>
+        <button type="button" role="tab" aria-selected={modo === 'semana'} className={modo === 'semana' ? 'on' : ''} onClick={() => elegirModo('semana')}>De la semana</button>
+      </div>
+
+      {modo === 'dia' ? (
+        <Navegador fecha={fecha} onCambiar={setFecha} />
+      ) : (
+        <div className="agenda-nav">
+          <div className="agenda-nav-row">
+            <button className="agenda-flecha" onClick={() => setLunes(sumarDias(lunes, -7))} aria-label="Semana anterior" disabled={lunes <= lunesDeLaSemana(hoyISO())}>‹</button>
+            <div className="agenda-fecha" style={{ cursor: 'default' }}>
+              <span className="agenda-fecha-dia">{rangoSemana}</span>
+              <span className="agenda-fecha-mes">martes a jueves</span>
+            </div>
+            <button className="agenda-flecha" onClick={() => setLunes(sumarDias(lunes, 7))} aria-label="Semana siguiente">›</button>
+          </div>
+        </div>
+      )}
+
+      {error && <p className="error-msg">{error}</p>}
+      {cargando && !hayDias && <div className="cargando">Armando la imagen…</div>}
+      {!cargando && dias && !hayDias && (
+        <p className="vacio">No hay días habilitados para mostrar en esta semana. Probá con la siguiente.</p>
+      )}
+
+      {hayDias && !hayLibres && !cargando && (
+        <p className="vacio">
+          {modo === 'dia' ? 'No quedan turnos libres ese día.' : 'No quedan turnos libres en esta semana.'} Probá con otra fecha.
+        </p>
+      )}
+
+      {hayDias && hayLibres && (
+        <>
+          <div className="vista-toggle historia-estilo" role="tablist" aria-label="Estilo de la imagen">
+            <button type="button" role="tab" aria-selected={estilo === 'claro'} className={estilo === 'claro' ? 'on' : ''} onClick={() => elegirEstilo('claro')}>Claro</button>
+            <button type="button" role="tab" aria-selected={estilo === 'azul'} className={estilo === 'azul' ? 'on' : ''} onClick={() => elegirEstilo('azul')}>Azul</button>
+            <button type="button" role="tab" aria-selected={estilo === 'dorado'} className={estilo === 'dorado' ? 'on' : ''} onClick={() => elegirEstilo('dorado')}>Dorado</button>
+          </div>
+          <div className="historia-vista" aria-busy={cargando}>
+            <canvas ref={canvasRef} className="historia-canvas" role="img" aria-label="Vista previa de la historia de turnos libres" />
+          </div>
+          <div className="historia-acciones">
+            <button className="btn btn-primary" onClick={descargar} disabled={cargando}>Descargar imagen</button>
+            {puedeCompartir && <button className="btn btn-ghost" onClick={compartir} disabled={cargando}>Compartir</button>}
+          </div>
+          <p className="historia-ayuda">
+            Para subirla: {puedeCompartir ? 'tocá Compartir y elegí Instagram → Historias, o ' : ''}descargala y elegila desde la galería al crear la historia.
+          </p>
+        </>
+      )}
+    </div>
+  );
+}
diff --git a/frontend/src/lib/historiaTurnos.js b/frontend/src/lib/historiaTurnos.js
